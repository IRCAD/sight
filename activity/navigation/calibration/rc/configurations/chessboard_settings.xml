<extension implements="sight::app::extension::config">
    <id>sight::geometry::vision::chessboard_settings</id>
    <parameters>
        <object uid="board_properties" type="sight::data::map" />
        <channel name="CLOSE_CONFIG" optional="true" />
    </parameters>
    <config>
        <!-- ******************************* UI declaration *********************************** -->

        <service uid="main_frame" type="sight::module::ui::frame">
            <window onclose="notify" />
            <gui>
                <frame>
                    <name>Chessboard settings</name>
                    <min_size width="400" />
                    <style mode="MODAL" />
                </frame>
            </gui>
            <registry>
                <view sid="main_view" />
            </registry>
        </service>

        <service uid="main_view" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="horizontal" />
                    <view proportion="0" />
                </layout>
            </gui>
            <registry>
                <view sid="chessboard_settings" />
            </registry>
        </service>

        <!-- ******************************* Services ***************************************** -->

        <service uid="chessboard_settings" type="sight::module::ui::qt::settings">
            <item data="${board_properties}.board_width" name="Chessboard width" widget="spin" min="3" max="50" />
            <item data="${board_properties}.board_height" name="Chessboard height" widget="spin" min="3" max="50" />
            <item data="${board_properties}.board_square_size" name="Chessboard square size (mm)" widget="spin" min="5" max="100" />
            <item data="${board_properties}.board_scale" name="Input scaling for chessboard detection" widget="spin" min="0." max="10." />
        </service>

        <!-- ******************************* Connections ***************************************** -->

        <connect channel="${CLOSE_CONFIG}">
            <signal>main_frame/closed</signal>
        </connect>
    </config>
</extension>
