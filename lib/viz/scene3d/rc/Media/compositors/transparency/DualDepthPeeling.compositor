compositor DualDepthPeeling
{
    technique
    {

        // temporary textures
        // Color buffer - used for blending
        texture gbuffer target_width target_height PF_R8G8B8A8
        // Ping buffer
        texture ping_buffer target_width target_height PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R
        // Pong buffer
        texture pong_buffer target_width target_height PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R PF_FLOAT32_R

         // Init peel buffer
         target ping_buffer
         {
             input none
             pass clear
             {
                 buffers colour depth
                 colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_init

             pass render_scene
             {
                // Surface models are in render queues 50 and below.
                last_render_queue 20
             }
         }

         // Blend clean
         target gbuffer
         {
             input none
             pass clear
             {
             }
         }

         // Peel 1
         target pong_buffer
         {
             input none
             pass clear
             {
             buffers colour depth
             colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_pong

             pass render_scene
             {
                last_render_queue 20
             }
         }

         // Blend 1
         target gbuffer
         {
            input none
            pass render_quad
            {
                material DualDepthPeeling/blend
                input 0 pong_buffer 3
                input 1 pong_buffer 5
            }
         }

         // Peel 2
         target ping_buffer
         {
             input none
             pass clear
             {
             buffers colour depth
             colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_ping

             pass render_scene
             {
                last_render_queue 20
             }
         }

         // Blend 2
         target gbuffer
         {
         input none
         pass render_quad
         {
         material DualDepthPeeling/blend
         input 0 ping_buffer 3
         input 1 ping_buffer 5
         }
         }

         // Peel 3
         target pong_buffer
         {
             input none
             pass clear
             {
             buffers colour depth
             colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_pong

             pass render_scene
             {
                last_render_queue 20
             }
         }

         // Blend 3
         target gbuffer
         {
         input none
         pass render_quad
         {
         material DualDepthPeeling/blend
         input 0 pong_buffer 3
         input 1 pong_buffer 5
         }
         }

         // Peel 4
         target ping_buffer
         {
             input none
             pass clear
             {
             buffers colour depth
             colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_ping

             pass render_scene
             {
                last_render_queue 20
             }
         }

         // Blend 4
         target gbuffer
         {
         input none
         pass render_quad
         {
         material DualDepthPeeling/blend
         input 0 ping_buffer 3
         input 1 ping_buffer 5
         }
         }

         // Peel 5
         target pong_buffer
         {
             input none
             pass clear
             {
             buffers colour depth
             colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_pong

             pass render_scene
             {
                last_render_queue 20
             }
         }

         // Blend 5
         target gbuffer
         {
         input none
         pass render_quad
         {
         material DualDepthPeeling/blend
         input 0 pong_buffer 3
         input 1 pong_buffer 5
         }
         }

         // Peel 6
         target ping_buffer
         {
             input none
             pass clear
             {
             buffers colour depth
             colour_value -1 0 0 0
             }

             shadows off
             material_scheme DualDepthPeeling/peel_ping

             pass render_scene
             {
                last_render_queue 20
             }
         }

         // Blend 6
         target gbuffer
         {
             input none
             pass render_quad
             {
                 material DualDepthPeeling/blend
                 input 0 ping_buffer 3
                 input 1 ping_buffer 5
             }
         }

        // Final pass
        target_output
        {
            input none

            pass clear
            {
            }

            pass render_quad
            {
                material DualDepthPeeling/Final
                input 0 gbuffer
                input 1 ping_buffer 2
                input 2 ping_buffer 4
            }

            // Render volumes on top.
            pass render_scene
            {
                // Volumes are in rq 30 and some of their widgets in rq 29.
                first_render_queue 29
                last_render_queue 30
            }

        }
    }
}
