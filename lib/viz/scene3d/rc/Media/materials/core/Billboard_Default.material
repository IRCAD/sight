//---------------------------------------------------------------------------

material Billboard_Default_Normal
{
    // Default technique
    technique
    {
        pass
        {
            cull_hardware none
            depth_check off
            // scene_blend alpha_blend
            // separate_scene_blend_op max add
            // separate_scene_blend src_alpha one_minus_src_alpha one one_minus_src_alpha

            vertex_program_ref Default/Billboard_Normal_VP
            {
            }

            geometry_program_ref Default/Billboard_Normal_GP
            {
            }

            fragment_program_ref Default/Billboard_Normal_FP
            {
            }

            texture_unit sprite
            {
                texture sphere.dds 2d
                tex_coord_set 0
                filtering bilinear
            }
        }
    }

    technique depth
    {
        pass
        {
            vertex_program_ref Default/Billboard_Normal_VP
            {
            }

            geometry_program_ref Default/Billboard_Depth_Normal_GP
            {
            }
        }
    }

}
