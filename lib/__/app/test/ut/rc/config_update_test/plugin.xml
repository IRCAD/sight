<plugin id="config_update_test">
    <extension implements="sight::app::extension::config">
        <id>sequence_cfg_test</id>
        <desc>Test configuration for simple update sequence</desc>
        <config>
            <service uid="test1_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test2_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test3_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test4_srv" type="sight::app::ut::test_reset_order_srv" />

            <connect>
                <signal>test3_srv/started</signal>
                <slot>updater1/start</slot>
            </connect>

            <update>
                <sequence uid="updater1" loop="true" start="false">
                    <service uid="test1_srv" />
                    <service uid="test2_srv" />
                    <service uid="test3_srv" />
                    <service uid="test4_srv" />
                </sequence>
            </update>
        </config>
    </extension>

    <extension implements="sight::app::extension::config">
        <id>sequence_worker_cfg_test</id>
        <desc>Test configuration for an update sequence worker</desc>
        <config>
            <update>
                <sequence uid="updater" start="false" worker="sequence_worker" />
            </update>
        </config>
    </extension>

    <extension implements="sight::app::extension::config">
        <id>shutdown_order_cfg_test</id>
        <desc>Test configuration shutdown order with an updater on a dedicated worker</desc>
        <config>
            <service uid="service" type="sight::app::ut::test_shutdown_service" worker="service_worker" />
            <service uid="updater" type="sight::app::ut::test_shutdown_updater" worker="updater_worker" />
        </config>
    </extension>

    <extension implements="sight::app::extension::config">
        <id>interrupt_update_wait_cfg_test</id>
        <desc>Test that an updater stop interrupts its wait for another worker</desc>
        <config>
            <service uid="blocking_service" type="sight::app::ut::test_blocking_update_service" worker="blocking_worker" />
            <update>
                <sequence uid="updater" worker="updater_worker">
                    <service uid="blocking_service" />
                </sequence>
            </update>
        </config>
    </extension>

    <extension implements="sight::app::extension::config">
        <id>imbricated_sequence_cfg_test</id>
        <desc>Test configuration for imbricated sequences</desc>
        <config>
            <service uid="test1_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test2_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test3_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test4_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test5_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test6_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test7_srv" type="sight::app::ut::test_reset_order_srv" />

            <connect>
                <signal>test7_srv/started</signal>
                <slot>updater1/start</slot>
            </connect>

            <update>
                <sequence uid="updater1" loop="true" start="false">
                    <service uid="test1_srv" />
                    <service uid="test2_srv" />
                    <parallel>
                        <service uid="test3_srv" />
                        <service uid="test4_srv" />
                    </parallel>
                    <parallel>
                        <service uid="test5_srv" />
                        <service uid="test6_srv" />
                    </parallel>
                    <service uid="test7_srv" />
                </sequence>
            </update>
        </config>
    </extension>

    <extension implements="sight::app::extension::config">
        <id>sub_sequence_cfg_test</id>
        <parameters>
            <param name="updater" />
        </parameters>
        <desc>Test configuration for a subconfig update sequence</desc>
        <config>
            <service uid="test1_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test2_srv" type="sight::app::ut::test_order_srv" />

            <update>
                <sequence parent="${updater}">
                    <service uid="test1_srv" />
                    <service uid="test2_srv" />
                </sequence>
            </update>
        </config>
    </extension>

    <extension implements="sight::app::extension::config">
        <id>multiple_config_sequence_cfg_test</id>
        <desc>Test configuration for sequences over multiple configuration</desc>
        <config>
            <service uid="test1_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test4_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test7_srv" type="sight::app::ut::test_order_srv" />
            <service uid="test8_srv" type="sight::app::ut::test_reset_order_srv" />

            <service uid="sub_cfg1_srv" type="sight::app::config_launcher">
                <config id="sub_sequence_cfg_test" />
                <param name="updater" value="sub_updater1" />
            </service>

            <service uid="sub_cfg2_srv" type="sight::app::config_launcher">
                <config id="sub_sequence_cfg_test" />
                <param name="updater" value="sub_updater2" />
            </service>

            <update>
                <sequence uid="updater1" loop="true">
                    <service uid="test1_srv" />
                    <updater uid="sub_updater1" />
                    <service uid="test4_srv" />
                    <updater uid="sub_updater2" />
                    <service uid="test7_srv" />
                    <service uid="test8_srv" />
                </sequence>
            </update>
        </config>
    </extension>
</plugin>
