// Substituted by the sight_gui_test() CMake macro: enables the self-supervision code path below
// for GUI tests only (REQUIRE_X ON, one QApplication/profile per scenario). Regular doctest unit
// tests run several TEST_CASEs in a single process and never need this.
#define SIGHT_GUI_TEST @SIGHT_GUI_TEST@

#if SIGHT_GUI_TEST
#include <QProcess>
#include <QStringList>
#endif

// Looked up by core at its static initialization, before this executable's own: enables the per-test logs.
#ifdef WIN32
#define SIGHT_TEST_EXPORT __declspec(dllexport)
#else
#define SIGHT_TEST_EXPORT __attribute__((visibility("default"), used))
#endif

extern "C" SIGHT_TEST_EXPORT constinit const char sight_test_target[] = "@SIGHT_TEST_TARGET_NAME@";

//------------------------------------------------------------------------------

/// Set while the GUI supervisor lists its scenarios: that query must not discard the process log.
static bool s_internal_enumeration = false;

//------------------------------------------------------------------------------

/// Result record of a test case, written in _buffer without allocation: it may be needed in a crash handler.
static std::string_view format_result(const doctest::CurrentTestCaseStats& _stats, std::array<char, 512>& _buffer)
{
    static constexpr std::array<std::pair<int, std::string_view>, 10> s_REASONS {{
        {doctest::TestCaseFailureReason::AssertFailure, "assert"},
        {doctest::TestCaseFailureReason::Exception, "exception"},
        {doctest::TestCaseFailureReason::Crash, "crash"},
        {doctest::TestCaseFailureReason::TooManyFailedAsserts, "too_many_failed_asserts"},
        {doctest::TestCaseFailureReason::Timeout, "timeout"},
        {doctest::TestCaseFailureReason::ShouldHaveFailedButDidnt, "should_have_failed"},
        {doctest::TestCaseFailureReason::ShouldHaveFailedAndDid, "failed_as_expected"},
        {doctest::TestCaseFailureReason::DidntFailExactlyNumTimes, "unexpected_failure_count"},
        {doctest::TestCaseFailureReason::FailedExactlyNumTimes, "expected_failure_count"},
        {doctest::TestCaseFailureReason::CouldHaveFailedAndDid, "may_fail"}
    }
    };

    auto* out       = _buffer.data();
    auto* const end = _buffer.data() + _buffer.size();
    const auto append =
        [&out, end](std::string_view _text)
        {
            out = std::format_to_n(out, end - out, "{}", _text).out;
            out = std::min(out, end);
        };

    append(_stats.testCaseSuccess ? "result=passed reasons=" : "result=failed reasons=");

    bool first = true;
    for(const auto& [flag, name] : s_REASONS)
    {
        if((_stats.failure_flags & flag) != 0)
        {
            append(first ? "" : "|");
            append(name);
            first = false;
        }
    }

    append(first ? "none" : "");
    out = std::format_to_n(
        out,
        end - out,
        " failed_asserts={}/{} seconds={:.3f}",
        _stats.numAssertsFailedCurrentTest,
        _stats.numAssertsCurrentTest,
        _stats.seconds
    ).out;

    return {_buffer.data(), static_cast<std::size_t>(std::min(out, end) - _buffer.data())};
}

//------------------------------------------------------------------------------

/// Opens one log per test case execution; subcase traversals stay in it.
///
/// Doctest starts and ends cases on the runner thread, but its crash handler ends them on the crashing thread, which
/// may be a worker: that path only uses the atomic pointer and fixed buffers.
class test_log_listener final : public doctest::IReporter
{
public:

    explicit test_log_listener(const doctest::ContextOptions& /*unused*/)
    {
    }

    //------------------------------------------------------------------------------

    void report_query(const doctest::QueryData& /*unused*/) override
    {
        // Any query main() did not catch
        if(!s_internal_enumeration)
        {
            sight::core::log::test_log::discard();
        }
    }

    //------------------------------------------------------------------------------

    void test_run_start() override
    {
    }

    //------------------------------------------------------------------------------

    void test_run_end(const doctest::TestRunStats& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_start(const doctest::TestCaseData& _test_case) override
    {
        m_current.store(nullptr);
        m_case.reset();
        m_case.emplace(
            sight::core::log::test_log::case_identity {
                .suite = _test_case.m_test_suite != nullptr ? _test_case.m_test_suite : "",
                .name  = _test_case.m_name != nullptr ? _test_case.m_name : "",
                .file  = _test_case.m_file.c_str(),
                .line  = _test_case.m_line
            });
        m_crash_size = 0;
        m_current.store(&*m_case);
    }

    //------------------------------------------------------------------------------

    void test_case_reenter(const doctest::TestCaseData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_exception(const doctest::TestCaseException& _exception) override
    {
        if(_exception.is_crash)
        {
            // Kept for test_case_end, which follows at once
            const auto result = std::format_to_n(
                m_crash.data(),
                static_cast<std::ptrdiff_t>(m_crash.size()),
                "Test case crashed: {}",
                _exception.error_string.c_str()
            );
            m_crash_size = std::min(static_cast<std::size_t>(result.size), m_crash.size());
        }
        else
        {
            SIGHT_ERROR("Test case threw: " << _exception.error_string.c_str());
        }
    }

    //------------------------------------------------------------------------------

    void test_case_end(const doctest::CurrentTestCaseStats& _stats) override
    {
        std::array<char, 512> buffer {};
        const auto result = format_result(_stats, buffer);

        if((_stats.failure_flags & doctest::TestCaseFailureReason::Crash) != 0)
        {
            // From the crash handler: no lock, no Boost.Log, no allocation, and the case object is left alone
            if(auto* const current = m_current.exchange(nullptr); current != nullptr)
            {
                const auto diagnostic = m_crash_size != 0
                                        ? std::string_view(m_crash.data(), m_crash_size)
                                        : std::string_view("Test case crashed");
                current->finish_after_crash(diagnostic, result);
            }

            return;
        }

        m_current.store(nullptr);
        if(m_case)
        {
            m_case->finish(result);
            m_case.reset();
        }
    }

    //------------------------------------------------------------------------------

    void subcase_start(const doctest::SubcaseSignature& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void subcase_end() override
    {
    }

    //------------------------------------------------------------------------------

    void log_assert(const doctest::AssertData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void log_message(const doctest::MessageData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_skipped(const doctest::TestCaseData& /*unused*/) override
    {
    }

private:

    std::optional<sight::core::log::test_log::case_log> m_case;
    std::atomic<sight::core::log::test_log::case_log*> m_current {nullptr};
    std::array<char, 256> m_crash {};
    std::size_t m_crash_size {0};
};

DOCTEST_REGISTER_LISTENER("sight_test_log", 1, test_log_listener);

//------------------------------------------------------------------------------

#if SIGHT_GUI_TEST

namespace
{

struct test_case_id
{
    std::string suite;
    std::string name;
};

//------------------------------------------------------------------------------

std::vector<test_case_id>& enumerated_cases()
{
    static std::vector<test_case_id> s_cases;
    return s_cases;
}

/// A reporter that captures the filtered test case list instead of printing it. Registered below
/// under the name "sight_enumerate" and selected explicitly by supervise() - it is never picked
/// up by a normal test run, which always uses the "console" default (or whatever --reporters
/// requests). See https://github.com/doctest/doctest for the IReporter interface.
struct enumerating_reporter final : public doctest::IReporter
{
    explicit enumerating_reporter(const doctest::ContextOptions& /*unused*/)
    {
    }

    //------------------------------------------------------------------------------

    void report_query(const doctest::QueryData& _data) override
    {
        auto& cases = enumerated_cases();
        cases.clear();
        cases.reserve(_data.num_data);

        for(unsigned i = 0 ; i < _data.num_data ; ++i)
        {
            const auto* const test_case = _data.data[i];
            cases.push_back(
                {
                    test_case->m_test_suite != nullptr ? test_case->m_test_suite : "",
                    test_case->m_name != nullptr ? test_case->m_name : ""
                });
        }
    }

    // The remaining IReporter methods are pure virtual and must all be defined, even empty: this
    // reporter is only ever used for report_query(), through --list-test-cases.
    void test_run_start() override
    {
    }

    //------------------------------------------------------------------------------

    void test_run_end(const doctest::TestRunStats& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_start(const doctest::TestCaseData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_reenter(const doctest::TestCaseData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_end(const doctest::CurrentTestCaseStats& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_exception(const doctest::TestCaseException& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void subcase_start(const doctest::SubcaseSignature& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void subcase_end() override
    {
    }

    //------------------------------------------------------------------------------

    void log_assert(const doctest::AssertData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void log_message(const doctest::MessageData& /*unused*/) override
    {
    }

    //------------------------------------------------------------------------------

    void test_case_skipped(const doctest::TestCaseData& /*unused*/) override
    {
    }
};

} // namespace

DOCTEST_REGISTER_REPORTER("sight_enumerate", 0, enumerating_reporter);

namespace
{

/// True for the well-known doctest command-line flag names that select which test case(s) to
/// run - the ones sight_doctest_discover_tests() (see cmake/build/doctestAddTests.cmake) passes
/// as "--test-case=..." "--test-suite=...". A re-exec for one specific scenario must drop these
/// from the parent's arguments before appending its own, or the child would still see the
/// parent's (probably absent, i.e. "run everything") filters instead.
bool is_test_filter_argument(const std::string& _arg)
{
    static const std::vector<std::string> s_prefixes = {
        "--test-case=", "-tc=",
        "--test-case-exclude=", "-tce=",
        "--test-suite=", "-ts=",
        "--test-suite-exclude=", "-tse="
    };

    for(const auto& prefix : s_prefixes)
    {
        if(_arg.compare(0, prefix.size(), prefix) == 0)
        {
            return true;
        }
    }

    return false;
}

//------------------------------------------------------------------------------

/// Returns argv[1..argc) as a QStringList, with every test-case/test-suite filter removed. All
/// other arguments (reporters, verbosity, Sight-specific options forwarded by the launcher
/// script, ...) are preserved so that a supervised child behaves exactly like the parent would
/// have for that one scenario.
QStringList forwarded_arguments_without_test_filters(int _argc, char** _argv)
{
    QStringList args;

    for(int i = 1 ; i < _argc ; ++i)
    {
        const std::string arg(_argv[i]);

        if(!is_test_filter_argument(arg))
        {
            args << QString::fromStdString(arg);
        }
    }

    return args;
}

//------------------------------------------------------------------------------

/// Re-executes this binary once per test case matching the command-line filters, and aggregates
/// the results. This is what lets a bare "./some_uit" (no filter, i.e. every scenario) work at
/// all: a GUI scenario owns a QApplication and a Sight profile lifecycle, and two of those in a
/// single process crash, so more than one scenario per process is not possible here.
/// @return the process exit code, or std::nullopt when supervision does not apply (0 or 1
///         matching test case) and the caller must run doctest in-process as usual - this is
///         always the path taken under CTest, since sight_doctest_discover_tests() always passes
///         an exact "--test-case=X --test-suite=Y" pair.
std::optional<int> supervise(int _argc, char** _argv)
{
    // A child re-executed by this very function already runs exactly one test case: never
    // recurse. SIGHT_GUI_TEST_NO_SUPERVISOR is the escape hatch for running a single scenario
    // under a debugger without the supervisor getting in the way (it never needs to, since a
    // single explicit --test-case already disables supervision below, but this makes the intent
    // explicit and future-proof).
    if(qEnvironmentVariableIsSet("SIGHT_GUI_TEST_CHILD") || qEnvironmentVariableIsSet("SIGHT_GUI_TEST_NO_SUPERVISOR"))
    {
        return std::nullopt;
    }

    // Ask doctest which test cases match the command-line filters, without running any of them.
    //
    // This must be built as a real argv array and parsed through applyCommandLine(), exactly as
    // if it had been typed on a command line: Context::setOption("list-test-cases", true)
    // synthesizes "-list-test-cases=true", which doctest's flag matcher rejects (it requires an
    // exact match, with nothing after the flag name) - list_test_cases then silently stays false,
    // and this "enumeration" pass actually **runs** the scenario for real instead of just listing
    // it, immediately followed by the real run below: two application lifecycles in one process,
    // which crashes. The original arguments are
    // forwarded so a user-provided filter (e.g. "--test-case=load_*") is honored by the
    // enumeration too; --list-test-cases, --reporters and --no-intro are appended last since
    // doctest resolves a repeated option from the last occurrence backwards.
    {
        std::vector<std::string> enumeration_args_storage(_argv, _argv + _argc);
        enumeration_args_storage.emplace_back("--list-test-cases");
        enumeration_args_storage.emplace_back("--reporters=sight_enumerate");
        enumeration_args_storage.emplace_back("--no-intro");

        std::vector<char*> enumeration_argv;
        enumeration_argv.reserve(enumeration_args_storage.size());
        for(auto& arg : enumeration_args_storage)
        {
            enumeration_argv.push_back(arg.data());
        }

        doctest::Context enumeration;
        enumeration.applyCommandLine(static_cast<int>(enumeration_argv.size()), enumeration_argv.data());
        s_internal_enumeration = true;
        enumeration.run();
        s_internal_enumeration = false;
    }

    const auto cases = enumerated_cases();

    // Zero or one matching case: nothing to supervise, the normal in-process path below handles
    // it (including doctest's own "no tests matched" diagnostics for the zero case). This is
    // always what CTest hits, since it always passes an exact suite/case pair.
    if(cases.size() <= 1)
    {
        return std::nullopt;
    }

    // program_location() resolves to the real executable (the .bin on Linux, the .exe on
    // Windows), not the launcher script: children inherit the DISPLAY (or, on Windows, the PATH)
    // that the parent's own launcher already set up, instead of each starting a redundant one.
    const auto self = QString::fromStdString(boost::dll::program_location().string());

    const QStringList base_args = forwarded_arguments_without_test_filters(_argc, _argv);

    // Children must not supervise in turn; their logs name this process as their parent.
    qputenv("SIGHT_GUI_TEST_CHILD", "1");
    qputenv("SIGHT_TEST_PARENT", QByteArray::fromStdString(sight::core::log::test_log::execution_id()));

    std::size_t failed = 0;

    for(const auto& test_case : cases)
    {
        QStringList args = base_args;
        args << QString::fromStdString("--test-case=" + test_case.name);

        if(!test_case.suite.empty())
        {
            args << QString::fromStdString("--test-suite=" + test_case.suite);
        }

        std::cout << "[sight] running " << test_case.suite << "::" << test_case.name << std::endl;

        sight::core::log::test_log::phase("child begin " + test_case.suite + "::" + test_case.name);
        const int code = QProcess::execute(self, args);
        sight::core::log::test_log::phase(
            std::format("child end {}::{} exit={}", test_case.suite, test_case.name, code)
        );

        if(code != 0)
        {
            ++failed;
            std::cerr << "[sight] FAILED " << test_case.suite << "::" << test_case.name
                      << " (exit code " << code << ")" << std::endl;
        }
    }

    std::cout << "[sight] " << (cases.size() - failed) << '/' << cases.size()
              << " GUI scenarios passed" << std::endl;

    return failed == 0 ? 0 : 1;
}

} // namespace

#endif // SIGHT_GUI_TEST

//------------------------------------------------------------------------------

static void init_runtime()
{
    // This variable is set when configuring this file in the fw_test() CMake macro
    static const std::string s_MODULE_NAME = "@TESTED_MODULE@"; // NOLINT(readability-redundant-string-init)
    if(!s_MODULE_NAME.empty())
    {
        SIGHT_INFO("Automatic loading of module '" + s_MODULE_NAME + "'");
        sight::core::runtime::init();
        const auto lib_location = boost::dll::this_line_location().parent_path().parent_path() / "@TESTED_MODULE_PATH@";
        sight::core::runtime::add_modules(lib_location.string());
        sight::core::runtime::load_module(s_MODULE_NAME);
        sight::core::log::test_log::phase("runtime initialized");
    }
}

//------------------------------------------------------------------------------

static void shutdown_runtime()
{
    // This variable is set when configuring this file in the fw_test() CMake macro
    static const std::string s_MODULE_NAME = "@TESTED_MODULE@"; // NOLINT(readability-redundant-string-init)
    if(!s_MODULE_NAME.empty())
    {
        sight::core::runtime::shutdown();
        sight::core::log::test_log::phase("runtime shut down");
    }
}

//------------------------------------------------------------------------------

/// True for help, version, count, list and no-run options, as parsed by Doctest. Unlike Context::shouldExit(), false
/// for --exit alone, which still runs the tests, and true for --no-run, which runs none.
static bool is_query(int _argc, char** _argv)
{
    std::vector<const char*> args(_argv, _argv + _argc);
    args.push_back("--exit=false");

    doctest::Context parsed;
    parsed.applyCommandLine(static_cast<int>(args.size()), args.data());

    // Doctest only exposes the parsed options of the default context; the next run() replaces it
    parsed.setAsDefaultForAssertsOutOfTestCases();
    return parsed.shouldExit() || doctest::getContextOptions()->no_run;
}

//------------------------------------------------------------------------------

/// Turns a success into a failure if the test logs failed meanwhile.
static int check_test_logs(int _result)
{
    if(_result == EXIT_SUCCESS)
    {
        if(const auto failure = sight::core::log::test_log::failure(); !failure.empty())
        {
            std::cerr << "[sight] test logs incomplete: " << failure << std::endl;
            return EXIT_FAILURE;
        }
    }

    return _result;
}

//------------------------------------------------------------------------------

/// Initializes the runtime of the tested module, and shuts it down on every return path.
class runtime_scope final
{
public:

    explicit runtime_scope(bool _enabled)
    {
        if(_enabled)
        {
            init_runtime();
            m_initialized = true;
        }
    }

    ~runtime_scope()
    {
        if(m_initialized)
        {
            try
            {
                shutdown_runtime();
            }
            catch(const std::exception& e)
            {
                SIGHT_ERROR("Runtime shutdown failed: " << e.what());
            }
        }
    }

    runtime_scope(const runtime_scope&)            = delete;
    runtime_scope(runtime_scope&&)                 = delete;
    runtime_scope& operator=(const runtime_scope&) = delete;
    runtime_scope& operator=(runtime_scope&&)      = delete;

private:

    bool m_initialized {false};
};

//------------------------------------------------------------------------------

int main(int argc, char** argv)
{
    namespace test_log = sight::core::log::test_log;

    doctest::Context context;
    context.applyCommandLine(argc, argv);

    const bool query = is_query(argc, argv);

    if(query)
    {
        test_log::discard();
    }
    else if(const auto failure = test_log::failure(); !failure.empty())
    {
        std::cerr << "[sight] test logs unavailable, tests not run: " << failure << std::endl;
        return EXIT_FAILURE;
    }

    test_log::phase("main entered");

#if SIGHT_GUI_TEST
    // Must run before any runtime/profile/QApplication setup: a supervised run re-executes this
    // same binary once per matching test case and never touches any of that itself. It also must
    // never trigger during --list-test-cases, which the CMake-time test discovery relies on.
    if(!query)
    {
        if(const auto supervised = supervise(argc, argv); supervised.has_value())
        {
            const int result = check_test_logs(*supervised);
            test_log::phase(std::format("main returned {}", result));
            return result;
        }
    }
#endif

    int result = EXIT_SUCCESS;
    {
        const runtime_scope runtime(!query);
        result = context.run();
    }

    // A case log could not be created or written; later writes are checked when core is unloaded
    if(!query)
    {
        result = check_test_logs(result);
    }

    test_log::phase(std::format("main returned {}", result));
    return result;
}
