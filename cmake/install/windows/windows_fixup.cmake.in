cmake_policy(SET CMP0011 NEW)
cmake_policy(SET CMP0012 NEW)
cmake_policy(SET CMP0053 NEW)
if(POLICY CMP0207)
    cmake_policy(SET CMP0207 NEW)
endif()

# Find all *.dll in /bin, Qt6 plugins and Ogre plugins
file(GLOB_RECURSE MODULES "@CMAKE_INSTALL_PREFIX@/@SIGHT_MODULE_LIB_PREFIX@/*@CMAKE_SHARED_LIBRARY_SUFFIX@")
file(GLOB_RECURSE QT_PLUGINS "@CMAKE_INSTALL_PREFIX@/plugins/*@CMAKE_SHARED_LIBRARY_SUFFIX@")
file(GLOB_RECURSE OGRE_PLUGINS "@CMAKE_INSTALL_PREFIX@/ogreplugins/*@CMAKE_SHARED_LIBRARY_SUFFIX@")

list(APPEND LIBS ${MODULES} ${QT_PLUGINS} ${OGRE_PLUGINS})

set(LAUNCHER_PATH @CMAKE_INSTALL_PREFIX@/@LAUNCHER_PATH@)

set(_install_bin "@CMAKE_INSTALL_PREFIX@/@CMAKE_INSTALL_BINDIR@")
set(_runtime_dependency_directories "${_install_bin}" "@SIGHT_VCPKG_ROOT_DIR@/bin" "@FW_SIGHT_EXTERNAL_LIBRARIES_DIR@")
set(_cuda_bin_dir "@CUDAToolkit_BIN_DIR@")
if(_cuda_bin_dir)
    # CUDA >= 13 ships its DLLs in bin/x64
    list(APPEND _runtime_dependency_directories "${_cuda_bin_dir}" "${_cuda_bin_dir}/x64")
endif()
list(REMOVE_ITEM _runtime_dependency_directories "")

file(GET_RUNTIME_DEPENDENCIES
    EXECUTABLES "${LAUNCHER_PATH}"
    LIBRARIES ${LIBS}
    DIRECTORIES ${_runtime_dependency_directories}
    PRE_EXCLUDE_REGEXES "^api-ms-" "^ext-ms-"
    POST_EXCLUDE_REGEXES "^[A-Za-z]:[/\\\\][Ww][Ii][Nn][Dd][Oo][Ww][Ss][/\\\\]"
    RESOLVED_DEPENDENCIES_VAR _resolved_dependencies
    UNRESOLVED_DEPENDENCIES_VAR _unresolved_dependencies
    CONFLICTING_DEPENDENCIES_PREFIX _conflicting_dependencies
)

if(_unresolved_dependencies)
    message(FATAL_ERROR "Unresolved runtime dependencies: ${_unresolved_dependencies}")
endif()

# A partially filled staging dir (rerun) holds copies of DLLs also found in vcpkg: only different contents conflict
foreach(_filename IN LISTS _conflicting_dependencies_FILENAMES)
    set(_paths ${_conflicting_dependencies_${_filename}})
    list(GET _paths 0 _first_path)
    file(SHA256 "${_first_path}" _first_hash)
    foreach(_path IN LISTS _paths)
        file(SHA256 "${_path}" _hash)
        if(NOT _hash STREQUAL _first_hash)
            list(APPEND _conflicts "${_filename}=${_paths}")
            break()
        endif()
    endforeach()
endforeach()
if(_conflicts)
    message(FATAL_ERROR "Conflicting runtime dependencies: ${_conflicts}")
endif()

if(NOT SIGHT_RUNTIME_DEPENDENCIES_MANIFEST)
    set(SIGHT_RUNTIME_DEPENDENCIES_MANIFEST "${CMAKE_CURRENT_LIST_DIR}/runtime-dependencies.tsv")
endif()
list(SORT _resolved_dependencies)
file(WRITE "${SIGHT_RUNTIME_DEPENDENCIES_MANIFEST}" "name\tsource\n")
set(_copied_names)
foreach(_dependency IN LISTS _resolved_dependencies)
    get_filename_component(_dependency_name "${_dependency}" NAME)
    string(TOLOWER "${_dependency_name}" _dependency_key)
    if(_dependency_key IN_LIST _copied_names)
        continue()
    endif()
    list(APPEND _copied_names "${_dependency_key}")
    set(_destination "${_install_bin}/${_dependency_name}")
    if(NOT "${_dependency}" STREQUAL "${_destination}")
        file(COPY "${_dependency}" DESTINATION "${_install_bin}")
    endif()
    file(APPEND "${SIGHT_RUNTIME_DEPENDENCIES_MANIFEST}" "${_dependency_name}\t${_dependency}\n")
endforeach()
list(LENGTH _copied_names _resolved_count)
message(STATUS "Resolved and copied ${_resolved_count} runtime dependencies to ${_install_bin}")
