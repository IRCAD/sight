<plugin id="tuto12_scene2d">
    <requirement id="sight::module::service" />
    <requirement id="sight::module::ui::qt" />
    <requirement id="sight::module::viz::scene2d" />

    <extension implements="sight::app::extension::config">
        <id>Tuto12Scene2D_AppCfg</id>
        <config>
            <!-- ******************************* UI declaration *********************************** -->

            <object uid="spacing_editor_srv_spacing" type="sight::data::dvec2" value="10.;10." />
            <object uid="depth_range_slider_srv_x" type="sight::data::real" value="0." />
            <object uid="depth_range_slider_srv_y" type="sight::data::real" value="0." />

            <service uid="mainFrame" type="sight::module::ui::frame">
                <gui>
                    <frame>
                        <name>tuto12_scene2d</name>
                        <icon>tuto12_scene2d/tuto.ico</icon>
                        <min_size width="800" height="600" />
                    </frame>
                </gui>
                <registry>
                    <view sid="mainView" />
                </registry>
            </service>

            <service uid="mainView" type="sight::module::ui::view">
                <gui>
                    <layout type="sight::ui::layout::line">
                        <orientation value="vertical" />
                        <view proportion="1" background_color="#36393E" />
                        <view proportion="0" background_color="#36393E" />
                    </layout>
                </gui>
                <registry>
                    <view sid="genericSceneSrv" />
                    <view sid="editorView" />
                </registry>
            </service>

            <service uid="editorView" type="sight::module::ui::view">
                <gui>
                    <layout type="sight::ui::layout::line">
                        <orientation value="vertical" />
                        <view proportion="1" />
                        <view proportion="1" />
                    </layout>
                </gui>
                <registry>
                    <view sid="spacingEditorSrv" />
                    <view sid="depthRangeSliderSrv" />
                </registry>
            </service>

            <!-- *************************** Begin generic scene *************************** -->

            <service uid="genericSceneSrv" type="sight::viz::scene2d::render">
                <scene>
                    <scene x="-100" y="-100" width="200" height="200" />
                    <axis id="axe1" origin="0.0" scale="1.0" scaleType="LINEAR" />

                    <adaptor uid="gridAdp" />
                    <adaptor uid="square1Adp" />
                    <adaptor uid="square2Adp" />
                    <adaptor uid="abscissaAdp" />
                    <adaptor uid="ordinateAdp" />
                </scene>
            </service>

            <service uid="gridAdp" type="sight::module::viz::scene2d::adaptor::grid2d">
                <config xMin="-150" xMax="150" yMin="-150" yMax="150" color="#619647" zValue="2" xAxis="axe1" yAxis="axe1" spacing="${spacing_editor_srv_spacing}" />
            </service>

            <service uid="square1Adp" type="sight::module::viz::scene2d::adaptor::square">
                <config size="15" color="#D25252" zValue="4" x="${depth_range_slider_srv_x}" y="${depth_range_slider_srv_y}" />
            </service>

            <service uid="square2Adp" type="sight::module::viz::scene2d::adaptor::square">
                <config x="20" y="20" size="30" color="#6997BB" zValue="4" />
            </service>

            <service uid="abscissaAdp" type="sight::module::viz::scene2d::adaptor::line">
                <config x1="-100" x2="100" y1="0" y2="0" color="#D25252" zValue="5" />
            </service>

            <service uid="ordinateAdp" type="sight::module::viz::scene2d::adaptor::line">
                <config x1="0" x2="0" y1="-100" y2="100" color="#D25252" zValue="6" />
            </service>

            <!-- ******************************* Services ***************************************** -->

            <service uid="spacingEditorSrv" type="sight::module::ui::qt::settings">
                <item data="${spacing_editor_srv_spacing}" name="Grid spacing" key="spacing" min="1." max="150." />
            </service>

            <service uid="depthRangeSliderSrv" type="sight::module::ui::qt::settings">
                <item data="${depth_range_slider_srv_x}" widget="slider" name="X" key="X" min="-100." max="100." />
                <item data="${depth_range_slider_srv_y}" widget="slider" name="Y" key="Y" min="-100." max="100." />
            </service>

            <!-- ******************************* Connections ***************************************** -->
        </config>
    </extension>
</plugin>
