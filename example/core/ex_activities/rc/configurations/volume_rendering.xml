<!-- This configuration allows to read an image and display it in a simple scene -->
<extension implements="sight::app::extension::config">
    <id>ex_activities::config::volume_rendering</id>
    <parameters>
        <object uid="image_series" type="sight::data::image_series" />
        <param name="WID_PARENT" />
    </parameters>
    <config>
        <!-- ******************************* Objects declaration ****************************** -->

        <object uid="tf" type="sight::data::transfer_function" />
        <object uid="mask" type="sight::data::image" />
        <object uid="extruded_model_series" type="sight::data::model_series" />
        <object uid="volume_parameters" type="sight::data::map">
            <item key="pre_integration" type="sight::data::boolean" value="false" />
            <item key="ambient_occlusion" type="sight::data::boolean" value="false" />
            <item key="color_bleeding" type="sight::data::boolean" value="false" />
            <item key="shadows" type="sight::data::boolean" value="false" />
            <item key="widgets" type="sight::data::boolean" value="true" />
            <item key="sampling" type="sight::data::integer" value="512" />
            <item key="opacity_correction" type="sight::data::integer" value="0" />
            <item key="sat_shells_number" type="sight::data::integer" value="4" />
            <item key="sat_shell_radius" type="sight::data::integer" value="4" />
            <item key="sat_cone_samples" type="sight::data::integer" value="50" />
            <item key="color_bleeding_factor" type="sight::data::real" value="1." />
            <item key="ao_factor" type="sight::data::real" value="1." />
            <item key="sat_cone_angle" type="sight::data::real" value="0.1" />
            <item key="sat_size_ratio" type="sight::data::real" value="2" />
        </object>

        <!-- ******************************* UI declaration *********************************** -->

        <service uid="main_view" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="vertical" />
                    <view proportion="0" />
                    <view proportion="0" />
                    <view proportion="0" />
                </layout>
                <toolbar />
            </gui>
            <registry>
                <parent wid="${WID_PARENT}" />
                <view sid="image_scene" />
                <view sid="tfm" />
                <toolbar sid="toolbar_view" />
            </registry>
        </service>

        <service uid="toolbar_view" type="sight::module::ui::toolbar">
            <gui>
                <layout>
                    <menuItem name="Import image" icon="sight::module::ui::icons/load.svg" />
                </layout>
            </gui>
            <registry>
                <menuItem sid="import_act" />
            </registry>
        </service>

        <!-- ******************************* Actions ****************************************** -->

        <service uid="import_act" type="sight::module::ui::io::selector">
            <data read="${image_series}" />
            <selection mode="include" />
            <addSelection service="sight::module::io::vtk::image_reader" />
        </service>

        <!-- ************************************* Services ************************************ -->

        <service uid="image_scene" type="sight::viz::scene3d::render">
            <scene>
                <background color="#36393E" />
                <layer id="default">
                    <adaptor uid="camera_interactor_adp" />
                    <adaptor uid="volume_render_adp" />
                </layer>
            </scene>
        </service>

        <service uid="camera_interactor_adp" type="sight::module::viz::scene3d::adaptor::trackball_camera">
            <config priority="0" />
        </service>

        <service uid="volume_render_adp" type="sight::module::viz::scene3d::adaptor::volume_render">
            <data image="${image_series}" />
            <data tf="${tf}" />
            <data mask="${mask}" />
            <volume_rendering>
                <config pre_integration="${volume_parameters}.pre_integration" />
                <config ambient_occlusion="${volume_parameters}.ambient_occlusion" />
                <config color_bleeding="${volume_parameters}.color_bleeding" />
                <config shadows="${volume_parameters}.shadows" />
                <config widgets="${volume_parameters}.widgets" />
                <config sampling="${volume_parameters}.sampling" />
                <config opacity_correction="${volume_parameters}.opacity_correction" />
                <config sat_shells_number="${volume_parameters}.sat_shells_number" />
                <config sat_shell_radius="${volume_parameters}.sat_shell_radius" />
                <config sat_cone_samples="${volume_parameters}.sat_cone_samples" />
                <config color_bleeding_factor="${volume_parameters}.color_bleeding_factor" />
                <config ao_factor="${volume_parameters}.ao_factor" />
                <config sat_cone_angle="${volume_parameters}.sat_cone_angle" />
                <config sat_size_ratio="${volume_parameters}.sat_size_ratio" />
            </volume_rendering>
            <config auto_reset_camera="true" />
        </service>

        <service uid="image_extruder_srv" type="sight::module::filter::image::image_extruder" worker="EXTRUSION">
            <input meshes="${extruded_model_series}" image="${image_series}" />
            <output mask="${mask}" />
        </service>

        <service uid="tfm" type="sight::module::ui::qt::image::transfer_function">
            <data tf="${tf}" image="${image_series}" />
        </service>

        <update uid="image_extruder_srv" />
    </config>
</extension>
