<extension implements="sight::app::extension::config">
    <id>ex_activities::base</id>
    <parameters>
        <param name="app_name" />
        <param name="app_version" />
        <param name="icon_path" />
        <param name="sequencer_config" />
        <param name="wizard_config" />
    </parameters>
    <config>
        <!-- ******************************* Objects declaration ****************************** -->

        <object uid="activity_set" type="sight::data::activity_set" />

        <!-- ******************************* UI declaration *********************************** -->

        <service uid="main_frame" type="sight::module::ui::frame">
            <gui>
                <frame>
                    <name>${app_name}</name>
                    <version>${app_version}</version>
                    <icon>${icon_path}</icon>
                    <min_size width="1280" height="800" />
                </frame>
            </gui>
            <registry>
                <view wid="activityView" />
            </registry>
        </service>

        <!-- ************************************* Services ************************************ -->

        <service uid="activity_launcher_srv" type="sight::app::config_launcher">
            <config id="sight::config::ui::activity::launcher" />
            <object name="activity_set" uid="${activity_set}" />
            <param name="sequencer_config" value="${sequencer_config}" />
            <param name="wizard_config" value="${wizard_config}" />
            <param name="icon_path" value="${icon_path}" />
            <param name="WID_PARENT" value="activityView" />
            <param name="session_reader_config" value="ex_activities::config::session_reader" />
            <param name="session_writer_config" value="ex_activities::config::session_writer" />
        </service>
    </config>
</extension>
