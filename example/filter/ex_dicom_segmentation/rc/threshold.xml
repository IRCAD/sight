<extension implements="sight::app::extension::config">
    <id>ExDicomSegmentation_Threshold_AppCfg</id>
    <parameters>
        <object uid="series_set" type="sight::data::series_set" />
        <object uid="image_series" type="sight::data::image_series" />

        <param name="WID_PARENT" />
        <param name="GENERIC_UID" />
    </parameters>
    <config>
        <!-- ******************************* Objects declaration ****************************** -->

        <object uid="image_series_mask" type="sight::data::image_series" />

        <!-- ******************************* UI declaration *********************************** -->

        <service uid="main_view" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="horizontal" />
                    <view proportion="1" />
                    <view proportion="1" />
                </layout>
                <toolbar />
            </gui>
            <registry>
                <parent wid="${WID_PARENT}" />
                <toolbar sid="tool_bar_view" />
                <view wid="negato1_view" />
                <view wid="negato2_view" />
            </registry>
        </service>

        <service uid="tool_bar_view" type="sight::module::ui::toolbar">
            <gui>
                <layout>
                    <menuItem name="Threshold" icon="sight::module::ui::icons/menu.svg" />
                    <menuItem name="Export Mask" icon="sight::module::ui::icons/save.svg" />
                </layout>
            </gui>
            <registry>
                <menuItem sid="threshold_act" />
                <menuItem sid="export_act" />
            </registry>
        </service>

        <!-- ************************************* Action ************************************ -->

        <service uid="threshold_act" type="sight::module::ui::action" />

        <service uid="threshold_srv" type="sight::module::filter::image::threshold">
            <input image="${image_series}" />
            <output image="${image_series_mask}" />
            <config lower="50" upper="255" />
        </service>

        <service uid="export_act" type="sight::module::ui::series::exporter" auto_connect="true">
            <data container="${series_set}" element="${image_series_mask}" />
        </service>

        <!-- ******************************* Services ***************************************** -->

        <service uid="negato1_srv" type="sight::app::config_launcher">
            <config id="sight::activity::viz::negato::2d" />
            <object name="image" uid="${image_series}" />
            <param name="WID_PARENT" value="negato1_view" />
            <param name="patient_name" value="Source Image" />
        </service>

        <service uid="negato2_srv" type="sight::app::config_launcher">
            <config id="sight::activity::viz::negato::2d" />
            <object name="image" uid="${image_series_mask}" />
            <param name="WID_PARENT" value="negato2_view" />
            <param name="patient_name" value="Mask Image" />
        </service>

        <connect>
            <signal>threshold_act/clicked</signal>
            <slot>threshold_srv/update</slot>
        </connect>
    </config>
</extension>
