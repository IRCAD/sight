<extension implements="sight::app::extension::config">
    <id>ExDicomSegmentation_Threshold_AppCfg</id>
    <parameters>
        <object uid="series_set" type="sight::data::series_set" />
        <object uid="image_series" type="sight::data::image_series" />

        <param name="WID_PARENT" />
        <param name="GENERIC_UID" />
    </parameters>
    <config>
        <!-- ******************************* Objects declaration ****************************** -->

        <object uid="image_series_mask" type="sight::data::image_series" deferred="true" />

        <!-- ******************************* UI declaration *********************************** -->

        <service uid="mainView" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="horizontal" />
                    <view proportion="1" />
                    <view proportion="1" />
                </layout>
                <toolbar />
            </gui>
            <registry>
                <parent wid="${WID_PARENT}" />
                <toolbar sid="toolBarView" />
                <view wid="negato1View" />
                <view wid="negato2View" />
            </registry>
        </service>

        <service uid="toolBarView" type="sight::module::ui::toolbar">
            <gui>
                <layout>
                    <menuItem name="Threshold" icon="sight::module::ui::icons/menu.svg" />
                    <menuItem name="Export Mask" icon="sight::module::ui::icons/save.svg" />
                </layout>
            </gui>
            <registry>
                <menuItem sid="thresholdAct" />
                <menuItem sid="exportAct" />
            </registry>
        </service>

        <!-- ************************************* Action ************************************ -->

        <service uid="thresholdAct" type="sight::module::filter::image::threshold">
            <input image="${image_series}" />
            <output image="${image_series_mask}" />
            <config>
                <threshold>50</threshold>
            </config>
        </service>

        <service uid="exportAct" type="sight::module::ui::series::exporter" auto_connect="true">
            <data container="${series_set}" element="${image_series_mask}" />
        </service>

        <!-- ******************************* Services ***************************************** -->

        <service uid="negato1Srv" type="sight::app::config_launcher">
            <config id="sight::activity::viz::negato::2d" />
            <object name="image" uid="${image_series}" />
            <param name="WID_PARENT" value="negato1View" />
            <param name="patient_name" value="Source Image" />
        </service>

        <service uid="negato2Srv" type="sight::app::config_launcher">
            <config id="sight::activity::viz::negato::2d" />
            <object name="image" uid="${image_series_mask}" />
            <param name="WID_PARENT" value="negato2View" />
            <param name="patient_name" value="Mask Image" />
        </service>
    </config>
</extension>
