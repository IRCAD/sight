<extension implements="sight::app::extension::config">
    <id>ExDicomSegmentation_VTKMesher_AppCfg</id>
    <parameters>
        <object uid="series_set" type="sight::data::series_set" />
        <object uid="image_series" type="sight::data::image_series" />

        <param name="WID_PARENT" />
        <param name="GENERIC_UID" />
    </parameters>
    <config>
        <!-- ******************************* Objects declaration ****************************** -->

        <object uid="tf" type="sight::data::transfer_function" />
        <object uid="model_series" type="sight::data::model_series" />
        <object uid="reconstruction" type="sight::data::reconstruction" deferred="true" />
        <object uid="snapshot" type="sight::data::image" />

        <!-- ******************************* UI declaration *********************************** -->

        <service uid="main_view" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="horizontal" />
                    <view proportion="1" />
                    <view proportion="0" minWidth="300" />
                </layout>
                <toolbar />
            </gui>
            <registry>
                <parent wid="${WID_PARENT}" />
                <toolbar sid="tool_bar_view" />
                <view sid="containerView" />
                <view sid="material_view" />
            </registry>
        </service>

        <service uid="tool_bar_view" type="sight::module::ui::toolbar">
            <gui>
                <layout>
                    <menuItem name="VTK Mesher" icon="sight::module::ui::icons/menu.svg" />
                    <menuItem name="Export model_series" icon="sight::module::ui::icons/save.svg" />
                </layout>
            </gui>
            <registry>
                <menuItem sid="mesher_act" />
                <menuItem sid="export_act" />
            </registry>
        </service>

        <service uid="containerView" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="vertical" />
                    <view proportion="1" />
                    <view proportion="0" minHeight="30" />
                </layout>
            </gui>
            <registry>
                <view sid="generic_scene_srv" />
                <view sid="parameters_view" />
            </registry>
        </service>

        <service uid="parameters_view" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::line">
                    <orientation value="horizontal" />
                    <view proportion="0" minWidth="50" />
                    <view proportion="1" />
                    <view proportion="0" minWidth="30" />
                </layout>
            </gui>
            <registry>
                <view sid="show_hide_negato_srv" />
                <view sid="slice_index_editor_srv" />
                <view sid="snapshot_srv" />
            </registry>
        </service>

        <service uid="material_view" type="sight::module::ui::view">
            <gui>
                <layout type="sight::ui::layout::toolbox">
                    <orientation value="vertical" />
                    <view caption="Organs" expanded="true" />
                    <view caption="Material" expanded="true" />
                    <view caption="Representation" />
                </layout>
            </gui>
            <registry>
                <view sid="model_series_list_srv" />
                <view sid="material_editor_srv" />
                <view sid="representation_srv" />
            </registry>
        </service>

        <!-- ************************************* Action ************************************ -->

        <service uid="mesher_act" type="sight::module::ui::action" />

        <service uid="mesher_srv" type="sight::module::filter::mesh::vtk_mesher">
            <data input_image="${image_series}" output_model="${model_series}" />
            <label value="255" />
            <decimation reduction="0" />
        </service>

        <service uid="export_act" type="sight::module::ui::series::exporter">
            <data container="${series_set}" element="${model_series}" />
        </service>

        <!-- ******************************* Begin Generic scene ******************************* -->

        <service uid="generic_scene_srv" type="sight::viz::scene3d::render">
            <scene>
                <background topColor="#36393E" bottomColor="#36393E" />

                <layer id="default">
                    <adaptor uid="model_series_adp" />
                    <adaptor uid="negato_adp" />
                    <adaptor uid="snapshot_adp" />
                </layer>
            </scene>
        </service>

        <service uid="model_series_adp" type="sight::module::viz::scene3d::adaptor::model_series">
            <data model="${model_series}" />
            <config picker="" />
        </service>

        <service uid="negato_adp" type="sight::module::viz::scene3d::adaptor::negato3d">
            <data image="${image_series}" />
            <data tf="${tf}" />
            <config orientation="axial" />
        </service>

        <service uid="snapshot_adp" type="sight::module::viz::scene3d::adaptor::fragments_info">
            <data image="${snapshot}" />
        </service>

        <!-- ******************************* Services ***************************************** -->

        <service uid="show_hide_negato_srv" type="sight::module::ui::qt::com::signal_button">
            <config>
                <checkable>true</checkable>
                <icon>sight::module::ui::icons/layers.svg</icon>
                <iconWidth>40</iconWidth>
                <iconHeight>16</iconHeight>
                <checked>true</checked>
            </config>
        </service>

        <service uid="snapshot_srv" type="sight::module::ui::qt::com::signal_button">
            <config>
                <checkable>false</checkable>
                <icon>sight::module::ui::icons/frame.svg</icon>
            </config>
        </service>

        <service uid="slice_index_editor_srv" type="sight::module::ui::qt::image::slice_index_position_editor">
            <data image="${image_series}" />
            <config orientation="axial" label="index" display_axis_selector="false" display_step_buttons="false" />
        </service>

        <service uid="model_series_list_srv" type="sight::module::ui::qt::model::model_series_list">
            <inout key="model_series" uid="model_series" />
            <columns>
                <organ_name />
            </columns>
        </service>

        <service uid="select_reconstruction_srv" type="sight::module::data::select_object">
            <out key="object" uid="reconstruction" />
        </service>

        <service uid="material_editor_srv" type="sight::module::ui::qt::reconstruction::organ_material_editor">
            <inout key="reconstruction" uid="reconstruction" />
        </service>

        <service uid="representation_srv" type="sight::module::ui::qt::reconstruction::representation_editor">
            <inout key="reconstruction" uid="reconstruction" />
        </service>

        <!-- Write the snapshot image -->
        <service uid="image_writer_srv" type="sight::module::io::bitmap::writer">
            <data write="${snapshot}" />
            <dialog policy="always" />
            <backends enable="all" mode="best" />
        </service>

        <!-- ******************************* Connections ***************************************** -->

        <connect>
            <signal>model_series_list_srv/reconstruction_selected</signal>
            <slot>select_reconstruction_srv/add</slot>
        </connect>

        <connect>
            <signal>show_hide_negato_srv/toggled</signal>
            <slot>negato_adp/update_visibility</slot>
        </connect>

        <connect>
            <signal>snapshot_srv/clicked</signal>
            <slot>image_writer_srv/update</slot>
        </connect>

        <connect>
            <signal>mesher_act/clicked</signal>
            <slot>mesher_srv/update</slot>
        </connect>
    </config>
</extension>
