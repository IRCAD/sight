<!--
This example shows the possibilities of properties:
- The two upper properties are linked together (the values are synchronized for the properties with the same name).
- The two lower properties allow to set the minimum/maximum values of the upper properties (with the same name).
   - The minimum of a parameter is connected to the minimum of the maximum parameter (and vice versa)
-->
<plugin id="ex_settings">
    <requirement id="sight::module::service" />
    <requirement id="sight::module::ui" />
    <requirement id="sight::module::ui::qt" />
    <requirement id="sight::module::io::joystick" />

    <extension implements="sight::app::extension::config">
        <id>ex_settings_app_cfg</id>
        <config>
            <!-- ******************************* UI declaration *********************************** -->

            <!-- We set an uid for each object, because in this sample, we pass the map to the first service -->
            <!-- and we pass each map element to the other services -->
            <object uid="settings" type="sight::data::map" preference="true">
                <item key="enable" type="sight::data::boolean" value="true" />
                <item key="bool_1" type="sight::data::boolean" value="false" />
                <item key="bool_2" type="sight::data::boolean" value="false" />
                <item key="text" type="sight::data::string" value="Hello" />
                <item key="text_ticks" type="sight::data::string" value="45" />
                <item key="int_ticks" type="sight::data::integer" value="66" />
                <item key="file" type="sight::data::string" value="path/to/file/to/read" />
                <item key="dir" type="sight::data::string" value="path/to/dir/to/write" />
                <item key="color_1" type="sight::data::color" value="#a55376b9" />
                <item key="double_1" type="sight::data::real" value="0.03" />
                <item key="double_2" type="sight::data::real" value="0.01" />
                <item key="double2_1" type="sight::data::dvec2" value="5.0;7.0" />
                <item key="double3_1" type="sight::data::dvec3" value="5.0;8.0;20.0" />
                <item key="int_1" type="sight::data::integer" value="50" />
                <item key="int_2" type="sight::data::integer" value="50" />
                <item key="int2_1" type="sight::data::ivec2" value="5;10" />
                <item key="int3_1" type="sight::data::ivec3" value="5;12;12" />
                <item key="enum_1" type="sight::data::string" value="V1" />
                <item key="nonlin" type="sight::data::integer" value="90" />
                <item key="buttonRaw" type="sight::data::integer" value="0" />
            </object>

            <service uid="main_frame" type="sight::module::ui::frame">
                <gui>
                    <frame>
                        <name>ex_settings</name>
                        <icon>ex_settings/app.ico</icon>
                        <min_size width="1200" />
                    </frame>
                    <menubar />
                </gui>
                <registry>
                    <view sid="mainview" />
                </registry>
            </service>

            <service uid="mainview" type="sight::module::ui::view">
                <gui>
                    <layout type="sight::ui::layout::line">
                        <orientation value="horizontal" />
                        <view proportion="0" QSSClass="Background" />
                        <view proportion="0" QSSClass="Background" />
                        <view proportion="0" QSSClass="Background" />
                    </layout>
                </gui>
                <registry>
                    <view sid="properties1_srv" />
                    <view sid="properties2_srv" />
                    <view sid="properties3_srv" />
                </registry>
            </service>

            <!-- ******************************* Services ******************************* -->

            <!-- Example using a map -->
            <service uid="properties1_srv" type="sight::module::ui::qt::settings">
                <config scrollable="true" />
                <item data="${settings}.enable" name="Enable" key="enable" />
                <item data="${settings}.bool_1" name="Boolean" depends="enable" widget="check_box" />
                <item data="${settings}.bool_2" name="Boolean switch" depends="enable" widget="switch_button" />
                <item data="${settings}.color_1" name="Color" depends="enable" />
                <item data="${settings}.double_1" name="Double 1" min="0.01" max="1." depends="enable" />
                <item data="${settings}.double_2" name="Double 2" widget="slider" joystick="left" joystick_axis="rx,tx" min="0." max="1000.58" decimal="1" depends="enable" />
                <item data="${settings}.double2_1" name="2 Double" widget="spin" min="0." max="100." depends="enable" />
                <item data="${settings}.double3_1" name="3 Double" widget="spin" min="0." max="100." depends="enable" />
                <item data="${settings}.int_1" name="Integer 1" widget="spin" min="0" max="100" depends="enable" />
                <item data="${settings}.int_2" name="Integer 2" widget="slider" joystick="left" joystick_axis="rx,tx" min="0" max="100" depends="enable" />
                <item data="${settings}.int2_1" name="2 Integer" widget="spin" min="0" max="100" depends="enable" />
                <item data="${settings}.int3_1" name="3 Integer" widget="spin" min="0" max="100" depends="enable" />
                <item data="${settings}.enum_1" name="Enum" widget="combobox" values="V0,V1=v1,V2=v2,V3=v3" />
                <item data="${settings}.nonlin" name="Combo slider" widget="comboslider" joystick="left" joystick_axis="rx" use_index="false" values="25,50,90,120,150" />
                <item data="${settings}.text_ticks" name="tickmarks" widget="tickmarks" values="45,75,100,150,200,250,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000" />
                <item data="${settings}.int_ticks" name="int tickmarks" widget="tickmarks" values="45,75,100,150,200,250,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000" />
                <item data="${settings}.buttonRaw" name="Button list:" widget="buttonBar" joystick="right" joystick_axis="rx,tz">
                    <item value="button1" label="extrude" icon="sight::module::ui::icons/extrude.svg" />
                    <item value="button2" label="Medicine Mode" icon="sight::module::ui::icons/image_series.svg" />
                    <item value="button3" label="Open settings" icon="sight::module::ui::icons/gear.svg" />
                    <item value="button4" label="Device TX 3267-AFV" icon="sight::module::ui::icons/add_distance.svg" />
                    <item value="button5" icon="sight::module::ui::icons/find.svg" />
                </item>
                <item data="${settings}.text" name="Text" widget="text" depends="enable" />
                <item data="${settings}.file" name="File" widget="file_write" depends="enable" />
                <item data="${settings}.dir" name="Dir" widget="dir_read" depends="enable" />
            </service>

            <!-- Example using individual objects -->
            <service uid="properties2_srv" type="sight::module::ui::qt::settings">
                <config scrollable="false" />
                <item data="${settings}.enable" name="Enable" key="enable_obj" />
                <item data="${settings}.bool_1" name="Boolean" depends="enable_obj" widget="check_box" />
                <item data="${settings}.bool_2" name="Boolean switch" depends="enable_obj" widget="switch_button" />
                <item data="${settings}.color_1" name="Color" depends="enable_obj" />
                <item data="${settings}.double_1" name="Double 1" min="0.01" max="1." depends="enable_obj" />
                <item data="${settings}.double_2" name="Double 2" widget="slider" min="0." max="1000.58" depends="enable_obj" />
                <item data="${settings}.double2_1" name="2 Double" widget="spin" min="0." max="100." depends="enable_obj" />
                <item data="${settings}.double3_1" name="3 Double" widget="spin" min="0." max="100." depends="enable_obj" />
                <item data="${settings}.int_1" name="Integer 1" widget="spin" min="0" max="100" depends="enable_obj" />
                <item data="${settings}.int_2" name="Integer 2" widget="slider" min="0" max="100" depends="enable_obj" />
                <item data="${settings}.int2_1" name="2 Integer" widget="spin" min="0" max="100" depends="enable_obj" />
                <item data="${settings}.int3_1" name="3 Integer" widget="spin" min="0" max="100" depends="enable_obj" />
                <item data="${settings}.enum_1" name="Enum" widget="combobox" values="V0,V1=v1,V2=v2,V3=v3" depends="enable_obj" />
                <item data="${settings}.nonlin" name="Combo box" widget="combobox" values="25,50,90,120,150" use_index="false" depends="enable_obj" />
                <item data="${settings}.text_ticks" name="tickmarks" widget="tickmarks" values="45,75,100,150,200,250,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000" depends="enable_obj" />
                <item data="${settings}.int_ticks" name="int tickmarks" widget="tickmarks" values="45,75,100,150,200,250,300,350,400,450,500,550,600,650,700,750,800,850,900,950,1000" depends="enable_obj" />
                <item data="${settings}.buttonRaw" name="Button list:" widget="buttonBar" hOffset="32">
                    <item value="button1" label="extrude" icon="sight::module::ui::icons/extrude.svg" />
                    <item value="button2" label="Medicine Mode" icon="sight::module::ui::icons/image_series.svg" />
                    <item value="button3" label="Open settings" icon="sight::module::ui::icons/gear.svg" />
                    <item value="button4" label="Device TX 3267-AFV" icon="sight::module::ui::icons/add_distance.svg" />
                    <item value="button5" icon="sight::module::ui::icons/find.svg" />
                </item>
                <item data="${settings}.text" name="Text" widget="text" depends="enable_obj" />
                <item data="${settings}.file" name="File" widget="file_write" depends="enable_obj" />
                <item data="${settings}.dir" name="Dir" widget="dir_read" depends="enable_obj" />
            </service>

            <service uid="properties3_srv" type="sight::module::ui::qt::settings">
                <config scrollable="true" />
                <item data="${settings}.enable" name="Enable" orientation="vertical" key="enable_obj" />
                <item data="${settings}.bool_1" name="Boolean" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.color_1" name="Color" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.double_1" name="Double 1" min="0.01" max="1." depends="enable_obj" orientation="vertical" />
                <item data="${settings}.double_2" name="Double 2" widget="slider" min="0." max="1000.58" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.double2_1" name="2 Double" widget="spin" min="0." max="100." depends="enable_obj" orientation="vertical" />
                <item data="${settings}.double3_1" name="3 Double" widget="spin" min="0." max="100." depends="enable_obj" orientation="vertical" />
                <item data="${settings}.int_1" name="Integer 1" widget="spin" min="0" max="100" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.int_2" name="Integer 2" widget="slider" min="0" max="100" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.int2_1" name="2 Integer" widget="spin" min="0" max="100" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.int3_1" name="3 Integer" widget="spin" min="0" max="100" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.enum_1" name="Enum" widget="combobox" values="V0,V1=v1,V2=v2,V3=v3" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.nonlin" name="Combo box" widget="combobox" values="25,50,90,120,150" use_index="false" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.buttonRaw" name="Button list:" widget="buttonBar" hOffset="32" orientation="vertical">
                    <item value="button1" label="extrude" icon="sight::module::ui::icons/extrude.svg" />
                    <item value="button2" label="Medicine Mode" icon="sight::module::ui::icons/image_series.svg" />
                    <item value="button3" label="Open settings" icon="sight::module::ui::icons/gear.svg" />
                    <item value="button4" label="Device TX 3267-AFV" icon="sight::module::ui::icons/add_distance.svg" />
                    <item value="button5" icon="sight::module::ui::icons/find.svg" />
                </item>
                <item data="${settings}.text" name="Text" widget="text" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.file" name="File" widget="file_write" depends="enable_obj" orientation="vertical" />
                <item data="${settings}.dir" name="Dir" widget="dir_read" depends="enable_obj" orientation="vertical" />
            </service>
        </config>
    </extension>
</plugin>
